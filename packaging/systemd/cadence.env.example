# Cadence service configuration — copy to ~/.config/cadence/cadence.env
# Every key maps to a CADENCE_* setting (see cadence/config.py + RuntimeConfig).
# Values here are literal (systemd EnvironmentFile does NOT expand $HOME / %h).

# --- HTTP ingest API ---------------------------------------------------------
# Distinctive default port 3245 (0x0CAD — "Cadence"); avoids 8000/8080 clashes.
CADENCE_HTTP_HOST=127.0.0.1
CADENCE_HTTP_PORT=3245

# The mTLS choke point is fail-closed by default (expects a TLS-terminating proxy
# to set the X-Client-Cert header). For a single-box local run with no proxy, set
# this false. Keep it true in production and front the API with a proxy.
CADENCE_REQUIRE_MTLS=false

# --- Engine / delivery -------------------------------------------------------
# shadow = propose nudges only (never sent); live = persist + deliver.
CADENCE_GOVERNOR_MODE=shadow
CADENCE_TICK_INTERVAL_SECONDS=60
# console | mock | fcm  (fcm needs CADENCE_FCM_* + a service-account in the vault)
CADENCE_DELIVERY_PROVIDER=console
#CADENCE_FCM_PROJECT_ID=your-firebase-project
#CADENCE_FCM_DEVICE_TOKENS=token1,token2

# --- devbox poller -----------------------------------------------------------
# Where the poller sends events. Match CADENCE_HTTP_PORT above.
CADENCE_INGEST_URL=http://127.0.0.1:3245/ingest/event
CADENCE_DEVBOX_POLL_SECONDS=300
# If REQUIRE_MTLS=true, the poller must present the proxy's client-cert header:
#CADENCE_CLIENT_CERT=...

# --- LLM (optional, off by default) ------------------------------------------
# Run `cadence-onboarding`/`python -m cadence.onboarding` first to store the cred.
#CADENCE_LLM_ENABLED=true
#CADENCE_LLM_PROVIDER=openai_api
#CADENCE_LLM_MODEL=gpt-5.5

# --- Production hardening -----------------------------------------------------
# CADENCE_ENV=prod makes the vault refuse the checked-in dev master key.
#CADENCE_ENV=prod
#CADENCE_VAULT_MASTER_KEY=change-me-to-a-real-secret
